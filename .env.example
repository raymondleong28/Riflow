# Environment Configuration Example (Copy to .env)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/rprm_kiflo_parity?schema=public"

# Local development login hints (never enable in production)
# SHOW_DEV_LOGINS="true"

# Outside-Service Connector Drivers (local defaults shown; live drivers fail closed without secrets)
EMAIL_DRIVER="local"
STORAGE_DRIVER="disk"
PAYOUT_DRIVER="manual"
HUBSPOT_DRIVER="mock"
FX_DRIVER="table"
SSO_DRIVER="local"
