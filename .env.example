# Required Database & Secrets (§16.2 S1, S5 & §16.3 G5, G6 — names only, provide >= 32-byte values in .env)
DATABASE_URL=""
SESSION_SECRET=""
BANK_ENCRYPTION_KEY=""
CRON_SECRET=""
APP_BASE_URL="http://127.0.0.1:3000"

# Local Seed Passwords (never used in production; G10 blocks seed in NODE_ENV=production)
SEED_ADMIN_PASSWORD=""
SEED_PARTNER_PASSWORD=""

# Optional Local Dev Login Hints (only shown when NODE_ENV !== 'production' AND SHOW_DEV_LOGINS="true")
SHOW_DEV_LOGINS="false"

# Outside-Service Connector Drivers (local defaults shown; live drivers fail closed without required secrets)
EMAIL_DRIVER="local"
STORAGE_DRIVER="disk"
PAYOUT_DRIVER="manual"
HUBSPOT_DRIVER="mock"
FX_DRIVER="table"
SSO_DRIVER="local"
